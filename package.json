{
  "name": "dsh-yangyu",
  "version": "0.2.0",
  "author": "YKY0521",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKY0521/dsh-yangyu.git"
  },
  "homepage": "https://github.com/YKY0521/dsh-yangyu#readme",
  "bugs": {
    "url": "https://github.com/YKY0521/dsh-yangyu/issues"
  },
  "description": "养鱼：多角色陪伴与独立记忆，支持微信／QQ扫码出游、私聊回复与二维码刷新。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "scripts/check.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "yangyu",
    "养鱼",
    "companion",
    "memory",
    "persona"
  ],
  "license": "MIT",
  "icon": "assets/icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
